#!/usr/bin/make -f

%:
	dh $@ --buildsystem=golang --with golang

override_dh_auto_install:
	dh_auto_install -- --no-source
	for name in agent-go v2; do \
		if [ -f debian/agentlet/usr/bin/$$name ]; then \
			mv debian/agentlet/usr/bin/$$name debian/agentlet/usr/bin/agentlet; \
			break; \
		fi; \
	done
	test -x debian/agentlet/usr/bin/agentlet
